# ─────────────────────────────────────────────
# Supabase (PostgreSQL via connection pooler)
# ─────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL (port 6543) for serverless/edge functions
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase API (optional – only needed if you use Supabase Auth / Storage / Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─────────────────────────────────────────────
# Clerk Authentication
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Price IDs
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_LIFETIME_PRICE_ID=price_xxx

# ─────────────────────────────────────────────
# Email (Nodemailer)
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=EasySSL <noreply@easyssl.com>

# ─────────────────────────────────────────────
# Encryption & Security
# ─────────────────────────────────────────────
# Generate a 32-byte hex string: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Renewal cron job security key
RENEWAL_CRON_KEY=your-secure-random-key-here

# ─────────────────────────────────────────────
# Let's Encrypt (ACME)
# ─────────────────────────────────────────────
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# For testing, use the staging URL:
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
